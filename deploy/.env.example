AUTH_DOMAIN=auth.example.edu

GEYSER_EDU_ENV=production
GEYSER_EDU_AUTH_PORT=8080
GEYSER_EDU_CLIENT_ID=00000000-0000-0000-0000-000000000000
GEYSER_EDU_CLIENT_SECRET=replace-with-entra-client-secret
GEYSER_EDU_TENANT=organizations
GEYSER_EDU_REDIRECT_URI=https://auth.example.edu/callback
GEYSER_EDU_ALLOWED_TENANTS=00000000-0000-0000-0000-000000000000
GEYSER_EDU_VERIFY_BEARER_TOKEN=replace-with-long-random-server-token
GEYSER_EDU_ADMIN_BEARER_TOKEN=replace-with-long-random-admin-token
GEYSER_EDU_PARTICIPATION_ID_HASH_SECRET=replace-with-long-random-hash-secret-at-least-32-chars
GEYSER_EDU_PARTICIPATION_TTL_MINUTES=10
GEYSER_EDU_VERIFY_RATE_LIMIT_PER_MINUTE=60
GEYSER_EDU_STORE_BACKEND=postgres
GEYSER_EDU_POSTGRES_JDBC_URL=jdbc:postgresql://postgres:5432/geyser_edu
GEYSER_EDU_POSTGRES_USERNAME=geyser_edu
GEYSER_EDU_POSTGRES_PASSWORD=replace-with-long-random-postgres-password
GEYSER_EDU_TICKET_STORE=/var/lib/geyser-edu-auth/participation-tickets.tsv
GEYSER_EDU_AUDIT_LOG=/var/log/geyser-edu-auth/audit.tsv

POSTGRES_DB=geyser_edu
POSTGRES_USER=geyser_edu
POSTGRES_PASSWORD=replace-with-long-random-postgres-password
